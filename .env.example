# Champi STT Configuration
# Copy this file to .env and customize for your environment
#
# NOTE: You can use either:
#   1. This .env file with environment variables
#   2. A YAML config file (config.yaml) - use 'champi-stt assistant init-config' to generate
# Both approaches support the same configuration options.

# ==========================================
# GENERAL CONFIGURATION
# ==========================================

# Config file path (alternative to individual env vars)
# If set, this overrides all other env vars
# CHAMPI_CONFIG_FILE=/path/to/config.yaml

# ==========================================
# LOGGING (applies to all components)
# ==========================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
CHAMPI_LOG_LEVEL=INFO

# Optional log file path for persistent logging
# CHAMPI_LOG_FILE=~/.cache/champi-stt/champi.log

# ==========================================
# STT PROVIDER CONFIGURATION
# ==========================================

# STT provider to use (default: whisperlive)
CHAMPI_STT_PROVIDER=whisperlive

# ==========================================
# WHISPERLIVE PROVIDER SETTINGS
# ==========================================

# Model configuration
WHISPERLIVE_MODEL=large-v3
WHISPERLIVE_LANGUAGE=en
WHISPERLIVE_TASK=transcribe

# Device settings
WHISPERLIVE_DEVICE=cuda
WHISPERLIVE_COMPUTE_TYPE=int8
WHISPERLIVE_CPU_THREADS=0

# Audio processing
WHISPERLIVE_DISABLE_VAD=false
WHISPERLIVE_WORD_TIMESTAMPS=false

# Performance tuning
WHISPERLIVE_BEAM_SIZE=5
WHISPERLIVE_BEST_OF=5
WHISPERLIVE_TEMPERATURE=0.0
WHISPERLIVE_BATCH_SIZE=8

# Cache directory
WHISPERLIVE_CACHE_DIR=/mnt/raid_0_drive/mcp_projs/champi/mcp_champi/whisper_cache

# Event system
WHISPERLIVE_ENABLE_EVENTS=true
WHISPERLIVE_EVENT_INTERVAL=1.0

# Transcription saving
WHISPERLIVE_SAVE_TRANSCRIPTIONS=false
# WHISPERLIVE_TRANSCRIPTIONS_DIR=~/.cache/champi-stt/transcriptions

# ==========================================
# AUDIO CONFIGURATION
# ==========================================

# Audio format (wav, mp3, etc.)
CHAMPI_STT_AUDIO_FORMAT=wav

# Sample rate in Hz
CHAMPI_SAMPLE_RATE=16000

# Input device name (leave empty for default)
# CHAMPI_INPUT_DEVICE=

# ==========================================
# SILENCE DETECTION (VAD)
# ==========================================

# Disable silence detection entirely
CHAMPI_DISABLE_SILENCE_DETECTION=false

# Silence threshold in milliseconds
CHAMPI_SILENCE_THRESHOLD_MS=800

# Minimum recording duration in seconds
CHAMPI_MIN_RECORDING_DURATION=0.3

# VAD aggressiveness (0.0-3.0)
CHAMPI_VAD_AGGRESSIVENESS=2.0

# VAD chunk duration in milliseconds
CHAMPI_VAD_CHUNK_DURATION_MS=30

# Initial silence grace period in seconds
CHAMPI_INITIAL_SILENCE_GRACE_PERIOD=3.0

# ==========================================
# WAKE WORD CONFIGURATION
# ==========================================

# Wake word keywords (comma-separated)
CHAMPI_WAKEWORD_KEYWORDS=hey_jarvis

# Wake word access key (deprecated, was for Porcupine)
# CHAMPI_WAKEWORD_ACCESS_KEY=

# ==========================================
# ASSISTANT SERVICE CONFIGURATION
# ==========================================

# Directories
# CHAMPI_CONFIG_DIR=~/.config/champi-stt
# CHAMPI_CACHE_DIR=~/.cache/champi-stt

# ==========================================
# IPC (INTER-PROCESS COMMUNICATION)
# ==========================================

# Shared memory namespace prefix
CHAMPI_ASSISTANT_MEMORY_PREFIX=champi_assistant

# Enable/disable UI subprocess
CHAMPI_ASSISTANT_UI_ENABLED=true
